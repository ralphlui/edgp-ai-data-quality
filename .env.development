# Development Environment Configuration
# EDGP AI Data Quality Engine

# Environment
ENVIRONMENT=development

# AWS Configuration - Development
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_REGION=ap-southeast-1

# SQS Queue URLs - Development
WORKFLOW_DEDUPLICATION_REQUEST_SQS_URL=WORKFLOW_DEDUPLICATION_REQUEST_SQS_URL
WORKFLOW_DEDUPLICATION_RESPONSE_SQS_URL=WORKFLOW_DEDUPLICATION_RESPONSE_SQS_URL

# DynamoDB Configuration - Development
DYNAMODB_TABLE_NAME=customerSIT
BLOCK_KEY_GSI_NAME=block-key-index

# OpenAI Configuration - Development
# Set to empty to force retrieval from AWS Secrets Manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Secrets Manager Configuration - Development
USE_SECRETS_MANAGER=true

# LangSmith Configuration - Development
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=edgp-ai-data-quality

# Prompt Injection Testing Configuration - Development
ENABLE_PROMPT_INJECTION_TEST=true
PROMPT_INJECTION_DATASET=ds-impassioned-soda-62

# Deduplication Configuration - Development (More lenient for testing)
SIMILARITY_THRESHOLD=0.80
FUZZY_SIMILARITY_THRESHOLD_HIGH=90.0
FUZZY_SIMILARITY_THRESHOLD_LOW=60.0
GPT_CONFIDENCE_THRESHOLD=0.70

# Logging Configuration - Development (More verbose)
LOG_LEVEL=DEBUG

# Performance Settings - Development
MAX_MESSAGES_PER_BATCH=5
PROCESSING_TIMEOUT=30
RETRY_ATTEMPTS=2

# Development Features
ENABLE_DETAILED_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true
MOCK_AWS_SERVICES=false
CACHE_GPT_RESPONSES=true
