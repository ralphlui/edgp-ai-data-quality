# Test Environment Configuration
# EDGP AI Data Quality Engine - For Testing Only

# Environment
ENVIRONMENT=test

# AWS Configuration - Test/Mock
AWS_ACCESS_KEY_ID=test-access-key-id
AWS_SECRET_ACCESS_KEY=test-secret-access-key
AWS_REGION=us-east-1

# SQS Queue URLs - Test/Mock
WORKFLOW_DEDUPLICATION_REQUEST_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/customer-input-queue-test
WORKFLOW_DEDUPLICATION_RESPONSE_SQS_URL=https://sqs.us-east-1.amazonaws.com/123456789012/customer-output-queue-test

# DynamoDB Configuration - Test
DYNAMODB_TABLE_NAME=customer_records_test

# OpenAI Configuration - Test/Mock
OPENAI_API_KEY=test-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Deduplication Thresholds - Test (more lenient)
SIMILARITY_THRESHOLD=0.80
GPT_CONFIDENCE_THRESHOLD=0.70

# Logging Configuration - Test
LOG_LEVEL=DEBUG
