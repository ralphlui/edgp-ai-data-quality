# Production Environment Configuration
# EDGP AI Data Quality Engine

# Environment
ENVIRONMENT=production

# AWS Configuration - Production
AWS_ACCESS_KEY_ID=AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=AWS_SECRET_ACCESS_KEY
AWS_REGION=AWS_REGION

# SQS Queue URLs - Production
WORKFLOW_DEDUPLICATION_REQUEST_SQS_URL=WORKFLOW_DEDUPLICATION_REQUEST_SQS_URL
WORKFLOW_DEDUPLICATION_RESPONSE_SQS_URL=WORKFLOW_DEDUPLICATION_RESPONSE_SQS_URL

# DynamoDB Configuration - Production
DYNAMODB_TABLE_NAME=customer
BLOCK_KEY_GSI_NAME=block-key-index

# OpenAI Configuration - Production
# Set to empty to force retrieval from AWS Secrets Manager
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Secrets Manager Configuration - Production
USE_SECRETS_MANAGER=true

# Deduplication Configuration - Production (Strict settings for production)
SIMILARITY_THRESHOLD=0.90
FUZZY_SIMILARITY_THRESHOLD_HIGH=92.0
FUZZY_SIMILARITY_THRESHOLD_LOW=75.0
GPT_CONFIDENCE_THRESHOLD=0.85

# Logging Configuration - Production (Optimized for performance)
LOG_LEVEL=WARNING

# Performance Settings - Production (High throughput)
MAX_MESSAGES_PER_BATCH=20
PROCESSING_TIMEOUT=120
RETRY_ATTEMPTS=5

# Production Features (Optimized for production)
ENABLE_DETAILED_LOGGING=false
ENABLE_PERFORMANCE_METRICS=true
MOCK_AWS_SERVICES=false
CACHE_GPT_RESPONSES=true
